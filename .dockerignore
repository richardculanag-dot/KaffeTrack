# Rebuilt inside the image
vendor
node_modules
public/build
public/hot

# Never bake secrets or local state into the image
.env
.env.*
!.env.example
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Not needed at runtime
.git
.github
.idea
.vscode
tests
docs
*.log
